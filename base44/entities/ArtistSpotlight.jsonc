{
  "name": "ArtistSpotlight",
  "type": "object",
  "properties": {
    "discovery_partner_id": {
      "type": "string"
    },
    "artist_profile_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "cover_image": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether this artist is featured prominently on the partner profile"
    },
    "community_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "view_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "discovery_partner_id",
    "artist_profile_id",
    "artist_name",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}