{
  "name": "SongStoreReview",
  "type": "object",
  "properties": {
    "song_id": {
      "type": "string",
      "description": "Reference to the Song being reviewed"
    },
    "song_title": {
      "type": "string",
      "description": "Snapshot of the song title at review time"
    },
    "artist_profile_id": {
      "type": "string",
      "description": "Reference to the ArtistProfile for the reviewed song"
    },
    "artist_name": {
      "type": "string",
      "description": "Snapshot of the artist name at review time"
    },
    "fan_user_id": {
      "type": "string",
      "description": "The fan who purchased the song and wrote the review"
    },
    "fan_name": {
      "type": "string",
      "description": "Display name of the reviewer, shown publicly on the review"
    },
    "rating": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "description": "Star rating from 1 to 5"
    },
    "title": {
      "type": "string",
      "maxLength": 120,
      "description": "Optional review headline"
    },
    "body": {
      "type": "string",
      "maxLength": 2000,
      "description": "The review comment text"
    },
    "verified_purchase": {
      "type": "boolean",
      "default": true,
      "description": "Whether the reviewer purchased this song. Reviews are only writable by fans with a paid order for this song."
    }
  },
  "required": [
    "song_id",
    "fan_user_id",
    "fan_name",
    "rating",
    "body"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "data.fan_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.fan_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.fan_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}