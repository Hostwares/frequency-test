{
  "name": "ArtistVerification",
  "type": "object",
  "properties": {
    "artist_profile_id": {
      "type": "string",
      "description": "Reference to ArtistProfile"
    },
    "artist_name": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Reference to User entity"
    },
    "verification_type": {
      "type": "string",
      "enum": [
        "human_created",
        "human_assisted",
        "ai_assisted",
        "ai_generated"
      ],
      "description": "Type of verification being requested"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "under_review",
        "verified",
        "rejected"
      ],
      "default": "pending"
    },
    "submission_date": {
      "type": "string",
      "format": "date-time"
    },
    "review_date": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Admin user ID who reviewed"
    },
    "verification_notes": {
      "type": "string",
      "description": "Admin notes about the verification decision"
    },
    "supporting_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs to supporting documents or evidence"
    },
    "artist_statement": {
      "type": "string",
      "description": "Artist's explanation of their creative process"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "artist_profile_id",
    "artist_name",
    "user_id",
    "verification_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}