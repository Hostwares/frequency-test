{
  "name": "NetworkNotification",
  "type": "object",
  "properties": {
    "artist_profile_id": {
      "type": "string",
      "description": "The artist receiving this notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "added_to_network",
        "network_endorsement",
        "new_connection"
      ],
      "description": "Notification type"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "network_name": {
      "type": "string",
      "description": "Name of the network they were added to"
    },
    "connected_by_artist_id": {
      "type": "string",
      "description": "The artist who added them to this network"
    },
    "connected_by_artist_name": {
      "type": "string",
      "description": "Name of the artist who added them"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "artist_profile_id",
    "type",
    "title",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}