{
  "name": "SplitSheet",
  "type": "object",
  "properties": {
    "song_id": {
      "type": "string",
      "description": "Reference to Song"
    },
    "song_title": {
      "type": "string"
    },
    "artist_profile_id": {
      "type": "string"
    },
    "rights_type": {
      "type": "string",
      "enum": [
        "master_ownership",
        "publishing",
        "mechanical",
        "neighboring",
        "performance",
        "synchronization"
      ],
      "description": "Type of rights being split"
    },
    "owner_user_id": {
      "type": "string",
      "description": "User ID of the rights owner"
    },
    "owner_name": {
      "type": "string",
      "description": "Display name of the rights owner"
    },
    "owner_role": {
      "type": "string",
      "enum": [
        "primary_artist",
        "featured_artist",
        "songwriter",
        "producer",
        "publisher",
        "label",
        "session_musician",
        "engineer",
        "co_writer",
        "co_producer",
        "other"
      ],
      "description": "Role of this rights owner"
    },
    "split_percentage": {
      "type": "number",
      "description": "Percentage of this rights type owned (0-100)"
    },
    "is_approved": {
      "type": "boolean",
      "default": false,
      "description": "Whether this split has been approved by the owner"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "ownership_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether ownership has been verified"
    },
    "verification_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs to verification documents"
    },
    "territory": {
      "type": "string",
      "description": "Territory this split applies to (e.g. 'Worldwide', 'US Only')"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "song_id",
    "song_title",
    "rights_type",
    "owner_name",
    "split_percentage"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}