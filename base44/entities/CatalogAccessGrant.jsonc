{
  "name": "CatalogAccessGrant",
  "type": "object",
  "properties": {
    "fan_user_id": {
      "type": "string",
      "description": "Fan who purchased direct catalog access"
    },
    "fan_name": {
      "type": "string"
    },
    "fan_email": {
      "type": "string"
    },
    "artist_profile_id": {
      "type": "string",
      "description": "Artist whose catalog the fan now has access to"
    },
    "artist_name": {
      "type": "string"
    },
    "artist_user_id": {
      "type": "string"
    },
    "purchase_policy": {
      "type": "string",
      "enum": [
        "current_catalog_access",
        "none"
      ],
      "default": "current_catalog_access",
      "description": "What the purchase granted. 'current_catalog_access' = listen to the artist's eligible catalog + add to personal listening playlists."
    },
    "granted_date": {
      "type": "string",
      "format": "date-time"
    },
    "source_order_id": {
      "type": "string",
      "description": "Order that granted this access"
    },
    "source_song_id": {
      "type": "string",
      "description": "The song that was purchased to unlock this grant"
    },
    "source_song_title": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "fan_user_id",
    "artist_profile_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.fan_user_id": "{{user.id}}"
        },
        {
          "data.artist_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.fan_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}