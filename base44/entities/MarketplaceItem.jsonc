{
  "name": "MarketplaceItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "artist_profile_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "merch",
        "vinyl",
        "cd",
        "poster",
        "ticket",
        "livestream_ticket",
        "lesson",
        "experience",
        "other"
      ],
      "default": "merch"
    },
    "price": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "stock_count": {
      "type": "number"
    },
    "is_available": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}