{
  "name": "ArtistPaymentMethod",
  "type": "object",
  "properties": {
    "artist_profile_id": {
      "type": "string",
      "description": "Reference to ArtistProfile"
    },
    "artist_user_id": {
      "type": "string",
      "description": "Reference to User entity"
    },
    "payment_provider": {
      "type": "string",
      "enum": [
        "stripe",
        "paypal",
        "wix_payments",
        "bank_transfer",
        "zelle"
      ],
      "default": "stripe"
    },
    "account_id": {
      "type": "string",
      "description": "Stripe account ID or PayPal email"
    },
    "account_email": {
      "type": "string",
      "description": "Email or mobile number associated with the payout account (e.g. Zelle email/mobile, PayPal email)"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the payment account is verified"
    },
    "payout_percentage": {
      "type": "number",
      "default": 85,
      "description": "Percentage artist receives (platform takes remainder)"
    },
    "minimum_payout": {
      "type": "number",
      "default": 50,
      "description": "Minimum amount before payout is triggered"
    },
    "payout_schedule": {
      "type": "string",
      "enum": [
        "instant",
        "weekly",
        "monthly"
      ],
      "default": "monthly"
    },
    "total_earned": {
      "type": "number",
      "default": 0
    },
    "pending_balance": {
      "type": "number",
      "default": 0
    },
    "last_payout_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_payout_amount": {
      "type": "number"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether automatic payout notifications are enabled"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "artist_profile_id",
    "artist_user_id",
    "payment_provider"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.artist_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.artist_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.artist_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.artist_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}