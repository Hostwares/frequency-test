{
  "name": "LaunchReadinessItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Pre-launch requirement title"
    },
    "description": {
      "type": "string",
      "description": "Details about this requirement"
    },
    "category": {
      "type": "string",
      "enum": [
        "infrastructure",
        "payments",
        "content",
        "security",
        "legal",
        "marketing",
        "launch"
      ],
      "default": "infrastructure",
      "description": "Requirement category"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete"
      ],
      "default": "pending",
      "description": "Whether this requirement is satisfied"
    },
    "notes": {
      "type": "string",
      "description": "Optional admin notes about this item"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "updated_by_user_id": {
      "type": "string"
    },
    "updated_by_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}