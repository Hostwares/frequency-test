{
  "name": "CommunityMessage",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string",
      "description": "Reference to FrequencyCommunity"
    },
    "author_user_id": {
      "type": "string",
      "description": "User who sent the message"
    },
    "author_name": {
      "type": "string"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "fan",
        "artist",
        "community_manager",
        "admin"
      ],
      "default": "fan"
    },
    "author_avatar": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "maxLength": 2000,
      "description": "Message content"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "File URLs attached to the message"
    },
    "event_id": {
      "type": "string",
      "description": "If this is an event discussion message, links to the Event"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_by": {
      "type": "string",
      "description": "User ID of who deleted the message"
    },
    "edited_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_flagged": {
      "type": "boolean",
      "default": false
    },
    "flagged_reason": {
      "type": "string"
    }
  },
  "required": [
    "community_id",
    "author_user_id",
    "author_name",
    "body"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}