{
  "name": "ArtistMessage",
  "type": "object",
  "properties": {
    "artist_profile_id": {
      "type": "string",
      "description": "Sender artist profile ID"
    },
    "artist_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "recipient_type": {
      "type": "string",
      "enum": [
        "all_supporters",
        "top_supporters",
        "patron_tier"
      ],
      "default": "all_supporters",
      "description": "Which supporters receive this message"
    },
    "read_by_fan_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fan user IDs who have marked this read",
      "default": []
    }
  },
  "required": [
    "artist_profile_id",
    "artist_name",
    "subject",
    "body"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}