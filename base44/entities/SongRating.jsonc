{
  "name": "SongRating",
  "type": "object",
  "properties": {
    "song_id": {
      "type": "string",
      "description": "Reference to Song entity"
    },
    "fan_user_id": {
      "type": "string",
      "description": "Reference to User entity (the fan leaving the rating)"
    },
    "artist_profile_id": {
      "type": "string",
      "description": "Reference to ArtistProfile for the song's artist"
    },
    "rating": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "description": "Star rating (1-5)"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "love",
        "like",
        "neutral",
        "dislike",
        "hate"
      ],
      "description": "Quick sentiment selection"
    },
    "mood_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "energetic",
          "chill",
          "emotional",
          "uplifting",
          "melancholic",
          "romantic",
          "angsty",
          "peaceful",
          "nostalgic",
          "empowering"
        ]
      },
      "description": "Mood tags selected by the fan",
      "maxItems": 3
    },
    "feedback_text": {
      "type": "string",
      "maxLength": 280,
      "description": "Optional short feedback comment"
    },
    "listen_count": {
      "type": "number",
      "default": 1,
      "description": "Number of times the fan has listened to this track"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false,
      "description": "Whether the fan marked this as a favorite"
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "description": "Whether this rating is visible to the artist publicly"
    }
  },
  "required": [
    "song_id",
    "fan_user_id",
    "rating"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.fan_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.fan_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.fan_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.fan_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}