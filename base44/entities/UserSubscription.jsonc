{
  "name": "UserSubscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who holds this subscription"
    },
    "user_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "plan_code": {
      "type": "string",
      "enum": [
        "free",
        "supporter",
        "premium_supporter",
        "champion",
        "founding_supporter",
        "artist_free",
        "frequency_free_beta",
        "founding_supporter_beta",
        "founding_premium_beta",
        "founding_champion_beta",
        "artist_free_beta",
        "artist_pro_beta",
        "artist_pro"
      ]
    },
    "plan_name": {
      "type": "string"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "default": "monthly"
    },
    "monthly_price": {
      "type": "number"
    },
    "is_founding_member": {
      "type": "boolean",
      "default": false,
      "description": "Founding members get locked pricing for life"
    },
    "is_locked_price": {
      "type": "boolean",
      "default": false,
      "description": "Price is locked and cannot be changed"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "canceled",
        "expired",
        "past_due",
        "trialing"
      ],
      "default": "active"
    },
    "started_date": {
      "type": "string",
      "format": "date-time"
    },
    "renewed_date": {
      "type": "string",
      "format": "date-time"
    },
    "next_billing_date": {
      "type": "string",
      "format": "date-time"
    },
    "canceled_date": {
      "type": "string",
      "format": "date-time"
    },
    "checkout_session_id": {
      "type": "string",
      "description": "Base44 Payments checkout session ID"
    },
    "subscription_id": {
      "type": "string",
      "description": "Base44 Payments recurring subscription ID"
    },
    "support_allocation_amount": {
      "type": "number",
      "default": 0,
      "description": "Monthly amount allocated to artists"
    },
    "referred_by_user_id": {
      "type": "string",
      "description": "User who referred this subscriber"
    },
    "referral_code_used": {
      "type": "string"
    },
    "disbursement_fulfilled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the current billing period's disbursement has been processed AND the admin/ops confirmation notification has been sent. Only flipped true after that notification succeeds."
    },
    "last_disbursement_period": {
      "type": "string",
      "description": "Billing period (YYYY-MM) of the most recent fulfilled disbursement"
    },
    "last_disbursement_fulfilled_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the most recent disbursement was marked fulfilled (notification confirmed sent)"
    },
    "monthly_rotations_used": {
      "type": "number",
      "default": 0,
      "description": "Number of standard artist slot changes (add/remove) used this month. Resets each billing period."
    },
    "rotation_period": {
      "type": "string",
      "description": "Billing period (YYYY-MM) that the current monthly_rotations_used counts against."
    },
    "discovery_passes_year": {
      "type": "number",
      "description": "Calendar year that discovery_passes_used counts against."
    },
    "discovery_passes_used": {
      "type": "number",
      "default": 0,
      "description": "Number of Discovery Passes activated this calendar year."
    },
    "purchase_unlocked_artist_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Artist profile IDs unlocked beyond the 25 standard-artist limit via qualifying song purchases. These artists do not count against the standard limit."
    }
  },
  "required": [
    "user_id",
    "plan_code",
    "billing_cycle"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}