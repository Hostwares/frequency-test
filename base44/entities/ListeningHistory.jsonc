{
  "name": "ListeningHistory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user who listened"
    },
    "song_id": {
      "type": "string",
      "description": "Reference to Song entity"
    },
    "song_title": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "artist_profile_id": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "cover_art": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    },
    "played_at": {
      "type": "string",
      "format": "date-time"
    },
    "position_seconds": {
      "type": "number",
      "default": 0,
      "description": "Where the user stopped listening"
    },
    "completion_percentage": {
      "type": "number",
      "default": 0,
      "description": "How much of the song was played"
    }
  },
  "required": [
    "user_id",
    "song_id",
    "song_title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}