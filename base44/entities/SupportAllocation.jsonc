{
  "name": "SupportAllocation",
  "type": "object",
  "properties": {
    "fan_user_id": {
      "type": "string"
    },
    "artist_profile_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Monthly support amount in dollars"
    },
    "tier": {
      "type": "string",
      "enum": [
        "basic",
        "supporter",
        "champion",
        "patron"
      ],
      "default": "basic"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_recurring": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is a recurring monthly subscription via Base44 Payments"
    },
    "subscription_id": {
      "type": "string",
      "description": "Wix subscription ID for managing recurring payments"
    },
    "checkout_session_id": {
      "type": "string",
      "description": "Wix checkout session ID for correlating webhook events"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "canceled",
        "ended"
      ],
      "default": "pending",
      "description": "Status of the recurring payment subscription"
    },
    "referred_by_artist_id": {
      "type": "string",
      "description": "If discovered through artist referral"
    },
    "referred_by_fan_id": {
      "type": "string",
      "description": "If discovered through fan referral"
    },
    "month": {
      "type": "string",
      "description": "YYYY-MM format"
    }
  },
  "required": [
    "fan_user_id",
    "artist_profile_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.fan_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.fan_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.fan_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.fan_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}