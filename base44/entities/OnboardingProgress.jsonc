{
  "name": "OnboardingProgress",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the User entity"
    },
    "role": {
      "type": "string",
      "description": "User role at time of onboarding"
    },
    "completed_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Step keys that have been completed"
    },
    "is_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether all required onboarding steps are done"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When all steps were marked complete"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}