{
  "name": "DiscoveryPass",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The subscriber who activated this Discovery Pass"
    },
    "activated_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the pass was activated"
    },
    "expiry_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the pass expires (default 30 days after activation)"
    },
    "bonus_artists_count": {
      "type": "number",
      "default": 10,
      "description": "Number of additional artists allowed beyond the standard 25-artist limit during this pass"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "grace_period",
        "expired",
        "converted"
      ],
      "default": "active",
      "description": "active = within 30-day window; grace_period = expired but fan has 7 days to convert; expired = temporary artists removed; converted = all artists kept"
    },
    "temporary_artist_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Artist IDs the fan added beyond the standard limit during this pass"
    },
    "converted_artist_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Artists the fan chose to keep permanently via song purchase or standard slot replacement"
    },
    "converted_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the pass was fully converted or expired"
    },
    "grace_period_end_date": {
      "type": "string",
      "format": "date-time",
      "description": "End of the 7-day grace period after expiry for the fan to convert temporary artists"
    },
    "pass_year": {
      "type": "number",
      "description": "The calendar year this pass counts against the annual allowance"
    },
    "expiry_notification_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the expiry/grace period notification was sent to the fan"
    }
  },
  "required": [
    "user_id",
    "activated_date",
    "expiry_date",
    "pass_year"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "master_admin"
          }
        }
      ]
    }
  }
}